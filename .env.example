POSTGRES_USER=rescue
POSTGRES_PASSWORD=change_me
POSTGRES_DB=rescue
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg2://rescue:change_me@localhost:5433/rescue

# Free Geoapify account, no Google Cloud Billing. Never use a VITE_ prefix for this key.
GEOAPIFY_API_KEY=
GEOCODING_ENABLED=true
GEOCODING_DAILY_LIMIT=200
GEOCODING_MONTHLY_LIMIT=4000
ROUTING_DAILY_LIMIT=50
ROUTING_MONTHLY_LIMIT=1000

# First admin is created only when this email does not exist. Use setup_demo.py locally.
INITIAL_ADMIN_EMAIL=admin@rescue.local
INITIAL_ADMIN_PASSWORD=
AUTH_COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8098
RESCUE_MODEL_DIR=ai/artifacts/prototype

# Optional LLM extraction only. Local extraction does not need these.
BASE_URL=
API_KEY=
